# How the browser reaches the NestJS API. Inlined into the client bundle at
# build time, so changing it requires a rebuild.
#
# Absolute URL - the browser calls the API directly and CORS applies. Used for
# local development and the Docker image:
NEXT_PUBLIC_API_URL=http://localhost:4000
#
# Relative path - API calls go to this app and are proxied on by the rewrite in
# next.config.ts. This is the Vercel setup: no CORS, and preview deployments
# work without registering their hostnames. Requires API_ORIGIN below.
#   NEXT_PUBLIC_API_URL=/api

# Origin of the API deployment that /api/* is proxied to. Server-side only, so
# it is never exposed in the browser bundle. Required only when
# NEXT_PUBLIC_API_URL is a relative path; the build fails with a clear message
# if it is missing.
#   API_ORIGIN=https://reportflow-api.vercel.app
