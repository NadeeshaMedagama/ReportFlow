# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection used by the running API. In serverless deployments (Vercel) this
# MUST be a pooled connection string, or concurrent function instances will
# exhaust PostgreSQL's connection slots.
#   local docker :  postgresql://postgres:postgres@localhost:5432/weekly_reports?schema=public
#   Neon pooled  :  postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weekly_reports?schema=public"

# Direct (unpooled) connection, used only by Prisma Migrate - migrations cannot
# run through a transaction-mode pooler. With no pooler, set it to DATABASE_URL.
#   Neon direct  :  postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/weekly_reports?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign JWT access tokens - use a long random string in production
# (openssl rand -base64 32)
JWT_SECRET="change-me-to-a-long-random-secret"
# Access token lifetime
JWT_EXPIRES_IN="8h"

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# HTTP port for the API. Ignored on Vercel, where the platform routes to the
# serverless handler instead of a listening port.
PORT=4000

# Allowed browser origin(s) for CORS, comma separated. A `*` wildcard may be
# used in the host label to cover Vercel preview deployments, and `*` alone
# allows any origin. Not needed when the web app proxies the API same-origin.
#   CORS_ORIGIN="https://reportflow.vercel.app,https://*.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI assistant (optional - Section 8). Leave empty to disable.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Guards against serverless function timeouts: the cap on a single Claude call,
# and on the whole tool-use loop. Keep both under the platform's maxDuration
# (60s on Vercel Hobby, configured in apps/api/vercel.json).
ASSISTANT_REQUEST_TIMEOUT_MS=45000
ASSISTANT_BUDGET_MS=50000
