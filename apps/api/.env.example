# PostgreSQL connection string (docker-compose default shown; see README for Homebrew/local variants)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weekly_reports?schema=public"

# Secret used to sign JWT access tokens - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
# Access token lifetime
JWT_EXPIRES_IN="8h"

# HTTP port for the API
PORT=4000
# Allowed browser origin(s) for CORS, comma separated
CORS_ORIGIN="http://localhost:3000"

# Optional: enables the AI assistant (Section 8). Leave empty to disable.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
